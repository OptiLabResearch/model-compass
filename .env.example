# Local project credentials. Copy this file to .env and fill in values.
# .env is ignored by git and must never be committed.

# Artificial Analysis API, used by scripts/fetch_aa_models.py
AA_API_KEY=

# Groq key for local Cloudflare Pages Function development.
# Production uses the GROQ_API_KEY Cloudflare Pages secret instead.
GROQ_API_KEY=
